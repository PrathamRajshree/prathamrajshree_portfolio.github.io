---
import Layout from '../layouts/Layout.astro';
import TypedText from '../components/TypedText.svelte';
import ThemeToggle from '../components/ThemeToggle.svelte';

const personalInfo = {
  name: "Pratham Rajshree",
  email: "prathamrajshree@gmail.com",
  github: "https://github.com/PrathamRajshree",
  linkedin: "https://in.linkedin.com/in/pratham-rajshree-a53331217",
};

const skills = [
  "Python", "C / C++", "Java", "HTML", "CSS", "JavaScript",
  "OOP", "DSA", "MongoDB", "APIs", "Node.js", "Tailwind CSS"
];

const projects = [
  {
    title: "Chat Notes App",
    description:
      "Its a website where you can interact with your notes. Upload a PDF and ask questions, summarize content, generate quizzes, flashcards, and download quiz PDFs.",
    liveUrl: "#",
    sourceUrl: "https://github.com/PrathamRajshree/chat-notes-app"
  },

  {
    title: "Voice-Based ADR Reporter",
    description:
      "A voice-enabled system that allows users to report adverse drug reactions using speech recognition and automated form filling.",
    Main_liveUrl: "https://voicebasedadr.web.app/",
	Dashboard_liveUrl:"https://voicebasedadr.web.app/admin_dashboard.html",
    sourceUrl: "https://github.com/PrathamRajshree/voice-based-adr-reporter"
  },

  {
    title: "Ephemeral File Sharing App (zyppp-share-pro)",
    description:
      "A privacy-focused file sharing web application that allows users to securely share files using custom links or QR codes, set expiry times, and enable self-destruct after a single download.",
    liveUrl: "http://51.21.194.94/",
    sourceUrl: "https://github.com/PrathamRajshree/zyppp-share-pro"
  }
];
---

<Layout title={`${personalInfo.name} - Portfolio`}>
  <header
    class="fixed top-0 left-0 w-full z-50 bg-primary/80 dark:bg-secondary/80 backdrop-blur-sm transition-shadow duration-300"
    id="header"
  >
    <nav class="container mx-auto px-6 py-4 flex justify-between items-center">
      <span class="text-xl font-bold text-accent cursor-default">
        {personalInfo.name}
      </span>

      <div class="flex items-center space-x-4">
        <div class="hidden md:flex space-x-8">
          <a href="#about" class="hover:text-accent transition-colors">About</a>
          <a href="#skills" class="hover:text-accent transition-colors">Skills</a>
          <a href="#projects" class="hover:text-accent transition-colors">Projects</a>
        </div>
        <ThemeToggle client:load />
      </div>
    </nav>
  </header>

  <main class="container mx-auto px-6">
    <section id="hero" class="min-h-screen flex flex-col justify-center">
      <p class="text-lg text-accent">Hello, my name is</p>
      <h1 class="text-5xl md:text-7xl font-bold my-2 text-text-primary">
        {personalInfo.name}
      </h1>
      <h2 class="text-4xl md:text-6xl font-bold text-text-secondary">
        I <TypedText client:visible />
      </h2>
      <p class="mt-4 text-text-secondary max-w-xl">
        A Computer Science student at VIT Vellore with a passion for building AI-integrated tools and solving real-world problems through code.
      </p>
    </section>

    <section id="about" class="py-24">
      <h2 class="text-4xl font-bold text-center mb-12">About Me</h2>
      <p class="max-w-3xl mx-auto text-center text-text-secondary text-lg">
        I am a Computer Science and Engineering student with strong interests in software development, AI-integrated tools, and problem-solving.
      </p>
    </section>

    <section id="skills" class="py-24">
      <h2 class="text-4xl font-bold text-center mb-12">Technical Skills</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4 max-w-4xl mx-auto">
        {skills.map(skill => (
          <div class="bg-card-bg border border-border rounded-lg p-4 text-center">
            {skill}
          </div>
        ))}
      </div>
    </section>

    <section id="projects" class="py-24">
      <h2 class="text-4xl font-bold text-center mb-12">My Projects</h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map(project => (
          <div class="bg-card-bg border border-border rounded-lg flex flex-col">
            <div class="p-6 flex-grow">
              <h3 class="text-2xl font-bold text-accent mb-2">
                {project.title}
              </h3>
              <p class="text-text-secondary">{project.description}</p>
            </div>

            <div class="p-6 pt-0 flex gap-6">
              <a
                href={project.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold hover:text-accent"
              >
                Source Code
              </a>

              {project.liveUrl !== "#" ? (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-semibold hover:text-accent"
                >
                  Live Demo
                </a>
              ) : null}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <footer class="text-center py-8 border-t border-border">
    <div class="flex justify-center space-x-6 mb-4">
      <a href={personalInfo.github} target="_blank">GitHub</a>
      <a href={personalInfo.linkedin} target="_blank">LinkedIn</a>
      <a href={`mailto:${personalInfo.email}`}>Email</a>
    </div>
    <p>Designed & Built by {personalInfo.name} © 2025</p>
  </footer>
</Layout>

<script>
  const header = document.getElementById('header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('shadow-lg');
    } else {
      header?.classList.remove('shadow-lg');
    }
  });
</script>
